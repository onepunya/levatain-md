# ── Bot Config (wajib) ─────────────────────────────────────────────────────────
# Nomor WhatsApp yang mau dijadiin bot. Format: 62xxxxxxxxxx (tanpa + atau spasi)
PAIRING_NUMBER=628xxxxxxxxxx

# Nomor WhatsApp owner/pemilik bot. Format sama seperti di atas.
OWNER_NUMBER=628xxxxxxxxxx

# Isi ini HANYA kalau isOwner masih gagal walau OWNER_NUMBER sudah benar (kasus LID).
# Cara ambil: set DEBUG=true di bawah → kirim pesan ke bot dari nomor owner → cek logs/bot.log
# baris [owner-check] → copy digit dari "lid=XXXXXXXXXX@lid" ke sini (angka saja, tanpa @lid).
OWNER_LID=

# ── Groq API Keys (auto-rotate kalau salah satu kena rate limit) ───────────────
# Minimal isi salah satu. Ambil gratis di https://console.groq.com/keys
GROQ_KEY_1=
GROQ_KEY_2=
GROQ_KEY_3=
GROQ_KEY_4=
GROQ_KEY_5=

# ── Naga API (fallback kalau semua Groq key habis/rate limit) ──────────────────
NAGA_API_KEY=
NAGA_MODEL=nemotron-3-ultra-550b-a55b:free

# ── OnePunya API (dipakai untuk beberapa fitur download/tools) ─────────────────
ONEPUNYA_API_KEY=
ONEPUNYA_BASE_URL=https://onepunya.qzz.io

# ── Giphy API (dipakai untuk fitur stiker mood/AI) ──────────────────────────────
# Ambil gratis di https://developers.giphy.com/
GIPHY_API_KEY=

# ── Magic Hour API (dipakai untuk fitur .editimage / .aiedit, auto-rotate) ─────
# Minimal isi salah satu. Daftar & ambil di https://magichour.ai (Dashboard → API Keys)
MAGICHOUR_KEY_1=
MAGICHOUR_KEY_2=
MAGICHOUR_KEY_3=

# ── Optional ─────────────────────────────────────────────────────────────────
# Alamat email opsional untuk fitur translate (MyMemory API), boleh dikosongin.
TRANSLATE_EMAIL=

# Port untuk dashboard web bot. Default 3000 kalau dikosongin.
DASHBOARD_PORT=3000

# Set "true" untuk nyalain log debug (termasuk log [owner-check] di atas).
DEBUG=false
