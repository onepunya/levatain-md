# ── Bot Config (required) ─────────────────────────────────────────────────────
# WhatsApp number to turn into the bot. Format: 62xxxxxxxxxx (no + or spaces)
PAIRING_NUMBER=628xxxxxxxxxx

# WhatsApp number of the bot's owner. Same format as above.
OWNER_NUMBER=628xxxxxxxxxx

# Fill this in ONLY if isOwner still fails even though OWNER_NUMBER is correct (LID case).
# How to get it: set DEBUG=true below → send a message to the bot from the owner's number → check logs/bot.log
# for the [owner-check] line → copy the digits from "lid=XXXXXXXXXX@lid" here (digits only, without @lid).
OWNER_LID=

# ── Bot branding (optional) ───────────────────────────────────────────────────
# Link and thumbnail shown in rich messages. Defaults are built in, leave blank to keep them.
BOT_LINK=
BOT_THUMB=

# ── Gemini (satu-satunya LLM, via a Google session cookie — not the official API) ────
# Session cookie for gemini.google.com (open gemini.google.com in a browser,
# DevTools → Network → any request → copy the "cookie" header). CAUTION: this
# is equivalent to your Google account password for this service — never commit
# the .env file to git or share it with anyone.
GEMINI_COOKIE=
# Optional but recommended: official Gemini API key (free tier). Used when the cookie is empty or fails.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Timezone for reminders and scheduled tasks
BOT_TIMEZONE=Asia/Jakarta

AGENT_MAX_STEPS=5
AGENT_TIMEOUT_MS=60000
# Regular users: smaller step budget, per-hour cap on tool steps
AGENT_MAX_STEPS_USER=4
AGENT_TIMEOUT_MS_USER=60000
AGENT_USER_STEPS_PER_HOUR=40
# Max read-only tools in one parallel batch (1-6)
AGENT_MAX_PARALLEL=4

# ── Naga API (HANYA untuk TTS voice note, bukan LLM) ───────────────────────────
NAGA_API_KEY=

# ── Giphy API (used for the mood/AI sticker feature) ────────────────────────────
# Get it for free at https://developers.giphy.com/
GIPHY_API_KEY=

# ── Magic Hour API (used for the .editimage / .aiedit feature, auto-rotate) ────
# Fill in at least one. Sign up and get it at https://magichour.ai (Dashboard → API Keys)
MAGICHOUR_KEY_1=
MAGICHOUR_KEY_2=
MAGICHOUR_KEY_3=

# ── GitHub Private Repo (remote database backup & recovery) ───────────────────
# Optional. If left empty the bot keeps using local ./database/db.json only.
# Recommended for production so data survives server wipe / crash.
#
# 1. Create a private repository (e.g. "levatain-db")
# 2. Create a Personal Access Token (classic) with "repo" scope:
#    https://github.com/settings/tokens → Generate new token (classic)
# 3. Fill the values below
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_DB_PATH=database/db.json
GITHUB_SYNC_TOKEN=
GITHUB_SYNC_REPO=
GITHUB_SYNC_BRANCH=main

# ── Optional ─────────────────────────────────────────────────────────────────
# Optional email address for the translate feature (MyMemory API), can be left blank.
TRANSLATE_EMAIL=

# Port for the bot's web dashboard. Defaults to 3000 if left blank.
DASHBOARD_PORT=

# Set to "true" to enable debug logging (including the [owner-check] log above).
DEBUG=false
