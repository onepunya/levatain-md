# ── Bot Config (required) ─────────────────────────────────────────────────────
# WhatsApp number to turn into the bot. Format: 62xxxxxxxxxx (no + or spaces)
PAIRING_NUMBER=628xxxxxxxxxx

# WhatsApp number of the bot's owner. Same format as above.
OWNER_NUMBER=628xxxxxxxxxx

# Fill this in ONLY if isOwner still fails even though OWNER_NUMBER is correct (LID case).
# How to get it: set DEBUG=true below → send a message to the bot from the owner's number → check logs/bot.log
# for the [owner-check] line → copy the digits from "lid=XXXXXXXXXX@lid" here (digits only, without @lid).
OWNER_LID=

# ── Gemini (primary AI, via a Google session cookie — not the official API) ────
# Session cookie for gemini.google.com (open gemini.google.com in a browser,
# DevTools → Network → any request → copy the "cookie" header). CAUTION: this
# is equivalent to your Google account password for this service — never commit
# the .env file to git or share it with anyone.
GEMINI_COOKIE=

# ── Naga API (fallback if all Gemini keys fail/hit their limit) ────────────────
NAGA_API_KEY=
NAGA_MODEL=nemotron-3-ultra-550b-a55b:free

# ── OnePunya API (used for certain download/tools features) ────────────────────
ONEPUNYA_API_KEY=
ONEPUNYA_BASE_URL=https://onepunya.qzz.io

# ── Giphy API (used for the mood/AI sticker feature) ────────────────────────────
# Get it for free at https://developers.giphy.com/
GIPHY_API_KEY=

# ── Magic Hour API (used for the .editimage / .aiedit feature, auto-rotate) ────
# Fill in at least one. Sign up and get it at https://magichour.ai (Dashboard → API Keys)
MAGICHOUR_KEY_1=
MAGICHOUR_KEY_2=
MAGICHOUR_KEY_3=

# ── AudD API (used for the .play song-recognition-from-audio/video feature) ────
# Sign up and get it for free at https://dashboard.audd.io/
AUDD_API_KEY=

# ── Shazam via RapidAPI (tried FIRST before AudD for song recognition) ─────────
# Sign up & subscribe (free plan available) at https://rapidapi.com/diyorbekkanal/api/shazam-api6
SHAZAM_RAPIDAPI_KEY=
SHAZAM_RAPIDAPI_HOST=shazam-api6.p.rapidapi.com

# ── Optional ─────────────────────────────────────────────────────────────────
# Optional email address for the translate feature (MyMemory API), can be left blank.
TRANSLATE_EMAIL=

# Port for the bot's web dashboard. Defaults to 3000 if left blank.
DASHBOARD_PORT=3000

# Set to "true" to enable debug logging (including the [owner-check] log above).
DEBUG=false
